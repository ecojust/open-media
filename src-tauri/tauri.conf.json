{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Media",
  "version": "0.3.1",
  "identifier": "com.ecojust.openmedia",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Open Media",
        "width": 1440,
        "height": 940,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/media/**",
          "$APPDATA/recordings/**"
        ]
      },
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: http://127.0.0.1:5200 ws://127.0.0.1:5200; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Video",
    "shortDescription": "Local recording, editing and media conversion",
    "resources": {
      "resources/media/": "media/",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../licenses/application/": "licenses/application/",
      "../licenses/video-generation/": "licenses/video-generation/",
      "../licenses/ai-generation/": "licenses/ai-generation/",
      "resources/speech/manifest.json": "speech/manifest.json",
      "resources/speech/runtime.json": "speech/runtime.json",
      "resources/speech/source-lock.json": "speech/source-lock.json",
      "resources/speech/model/": "speech/model/",
      "resources/speech/licenses/": "speech/licenses/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "files": {
        "Helpers/speech/runtime": "resources/speech/runtime"
      }
    }
  }
}
