  {
    "name": "open_media_focus_region",
    "description": "聚焦画面区域，生成等比放大、停留与恢复的平滑关键帧。区域为当前片段显示矩形内的归一化坐标，保留基础位置、尺寸、裁切和画面比例。默认最大放大 3 倍；已有位置或缩放关键帧需要明确允许替换。省略停留与恢复时长时，保持放大后的画面。\n执行方式：同步返回最终结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "region": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 86400
        },
        "easing": {
          "type": "string",
          "enum": [
            "linear",
            "ease-in",
            "ease-out",
            "ease-in-out",
            "step"
          ]
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "holdDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "returnDuration": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "maxScale": {
          "type": "number",
          "minimum": 1,
          "maximum": 16
        },
        "strength": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 1
        },
        "replaceExisting": {
          "type": "boolean"
        }
      },
      "required": [
        "clipId",
        "region"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "synchronous",
        "responseType": "result"
      }
    }
  },
  {
    "name": "open_media_overlay_add",
    "description": "新增可编辑视觉标注。支持箭头、矩形框、椭圆框、四角括号、双向箭头、折线引注、下划线、勾号、高亮、遮罩、聚光灯和局部模糊。位置单位为项目像素；聚光灯的矩形指定保留亮度的区域。可选animation生成入场、停留、退场关键帧；省略时不添加动画。\n执行方式：同步返回最终结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "arrow",
            "rectangle",
            "ellipse",
            "brackets",
            "double-arrow",
            "leader",
            "underline",
            "check",
            "highlight",
            "mask",
            "spotlight",
            "blur"
          ]
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        },
        "duration": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 86400
        },
        "x": {
          "type": "number",
          "minimum": -65536,
          "maximum": 65536
        },
        "y": {
          "type": "number",
          "minimum": -65536,
          "maximum": 65536
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 65536
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 65536
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "blurRadius": {
          "type": "number",
          "minimum": 1,
          "maximum": 50
        },
        "rotation": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "trackId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "animation": {
          "type": "string",
          "enum": [
            "none",
            "fade",
            "slide-up",
            "slide-down",
            "slide-left",
            "slide-right",
            "push-in",
            "pull-back"
          ]
        }
      },
      "required": [
        "kind",
        "start",
        "duration",
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "synchronous",
        "responseType": "result"
      }
    }
  },
