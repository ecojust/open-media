  {
    "name": "open_media_asset_storyboard",
    "description": "生成素材分镜联系表。mode=time按时间均匀抽帧；mode=scene按真实画面差异检测场景，并取每个场景的代表帧（单次范围最多600秒）。count为最多帧数，场景不足时不重复补图；超过上限时按场景顺序均匀选取。返回实际sourceTime、场景边界与检测依据。编码总量最多8 MiB。\n执行方式：异步操作：立即返回 jobId（兼容 id），此时不是最终结果。使用 open_media_job_get({id:jobId}) 查询；state=completed 后读取 result，failed 时读取 errorDetails；可用 open_media_job_cancel({id:jobId}) 取消。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId"
      ],
      "properties": {
        "assetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24,
          "default": 8
        },
        "maxWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1920,
          "default": 480
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "type": "string",
          "enum": [
            "time",
            "scene"
          ],
          "default": "time"
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.3,
          "description": "scene模式画面差异阈值；不表示语义识别。"
        },
        "expectedProjectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "可选：从 project_get 获取的当前工程 ID；不一致时拒绝执行，请重新读取当前工程。"
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
