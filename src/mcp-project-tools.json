[
  {
    "name": "open_media_timeline_batch_edit",
    "description": "原子批量编辑时间线与项目。按顺序在隔离副本执行 1 至 100 个同步编辑，任一步失败全部不写入；成功只产生一次撤销记录。dryRun=true 仅预检，返回各操作结果但不提交。不得嵌套批量、导入文件、生成配音或其他异步/外部操作。\n执行方式：异步操作：立即返回 jobId（兼容 id），此时不是最终结果。使用 open_media_job_get({id:jobId}) 查询；state=completed 后读取 result，failed 时读取 errorDetails；可用 open_media_job_cancel({id:jobId}) 取消。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string",
                "enum": [
                  "open_media_project_update",
                  "open_media_asset_remove",
                  "open_media_track_add",
                  "open_media_track_update",
                  "open_media_track_remove",
                  "open_media_track_reorder",
                  "open_media_clip_add",
                  "open_media_text_add",
                  "open_media_clip_update",
                  "open_media_clip_move",
                  "open_media_clip_split",
                  "open_media_clip_classify",
                  "open_media_clip_trim",
                  "open_media_clip_duplicate",
                  "open_media_clip_remove",
                  "open_media_clip_restore_audio_length",
                  "open_media_clip_extract_audio",
                  "open_media_subtitle_apply_style",
                  "open_media_timeline_close_gaps",
                  "open_media_transition_add",
                  "open_media_transition_update",
                  "open_media_transition_remove",
                  "open_media_speech_align",
                  "open_media_timeline_markers_set",
                  "open_media_clip_keyframes_set",
                  "open_media_clip_crop",
                  "open_media_focus_region",
                  "open_media_overlay_add",
                  "open_media_title_add",
                  "open_media_template_customize",
                  "open_media_clip_freeze_frame",
                  "open_media_clip_speed_ramp",
                  "open_media_transition_parameters_set"
                ]
              },
              "arguments": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "required": [
              "tool",
              "arguments"
            ],
            "additionalProperties": false
          }
        },
        "dryRun": {
          "type": "boolean"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "当前项目 revision，不一致时拒绝操作。"
        }
      },
      "required": [
        "operations"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "jobIdField": "jobId",
        "statusField": "state",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "resultField": "result",
        "errorField": "errorDetails",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  },
  {
    "name": "open_media_timeline_markers_set",
    "description": "完整替换当前项目的章节、重点和待检查标记。time 单位为秒；省略 id 时生成新 ID。空数组清除全部标记。标记随项目文件和快照保存。\n执行方式：同步返回最终结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "markers": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "time": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "kind": {
                "type": "string",
                "enum": [
                  "chapter",
                  "highlight",
                  "review"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "required": [
              "time",
              "label",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "当前项目 revision，不一致时拒绝操作。"
        }
      },
      "required": [
        "markers"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "synchronous",
        "responseType": "result"
      }
    }
  },
  {
    "name": "open_media_project_snapshot",
    "description": "管理当前工程的本地命名版本：create 需要 name；list 列出版本；compare 需要 id，省略 comparisonId 时与当前工程比较；restore 和 delete 需要 id。创建/恢复含真实媒体的便携包，关闭重开后保留，不依赖临时素材URL。所有工程合计最多100份、1GiB；每份最多256MiB媒体。恢复产生一次可撤销编辑；删除不可撤销。长操作返回 jobId。\n执行方式：异步操作：立即返回 jobId（兼容 id），此时不是最终结果。使用 open_media_job_get({id:jobId}) 查询；state=completed 后读取 result，failed 时读取 errorDetails；可用 open_media_job_cancel({id:jobId}) 取消。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "create",
            "list",
            "compare",
            "restore",
            "delete"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "comparisonId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "当前项目 revision，不一致时拒绝操作。"
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "jobIdField": "jobId",
        "statusField": "state",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "resultField": "result",
        "errorField": "errorDetails",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  },
  {
    "name": "open_media_project_video_compress",
    "description": "为已导入工程的视频生成剪辑工作副本，未加入时间线也可先压缩；按源文件去重处理并一次替换同源的所有视频和音频片段引用。压缩副本立即用于播放、拖动、字幕与转场合成预览，后续新增片段也使用当前副本。lossless 为严格无损模式，不能设置 quality；quality 模式默认 high，可选 balanced、compact。保留尺寸、时间线和原件，重复压缩始终读取最初原件。体积未减少时跳过；支持取消、撤销和恢复原视频。保留原件会增加工程归档体积，压缩不保证所有特效导出提速。锁定轨道引用的视频需先解锁。\n执行方式：异步操作，立即返回 jobId；使用 open_media_job_get({id:jobId}) 查询，completed 后读取 result；使用 open_media_job_cancel({id:jobId}) 取消。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "lossless",
            "quality"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "high",
            "balanced",
            "compact"
          ]
        },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "description": "源视频或工程压缩视频的素材 ID；可传一个 ID 对应素材右键操作，省略时处理工程已导入的普通视频及当前使用的库视频。"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "当前项目 revision，不一致时拒绝操作。"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "jobIdField": "jobId",
        "statusField": "state",
        "resultField": "result",
        "errorField": "errorDetails",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  },
  {
    "name": "open_media_project_video_restore",
    "description": "将工程当前启用的剪辑工作副本恢复为最初原视频，同步恢复视频和音频片段引用；保留全部片段时间、画面与效果参数，保留工作副本，可撤销。assetIds 可指定原件或压缩素材，省略时恢复全部当前启用的压缩视频，尚未加入时间线的副本也会恢复。恢复前检查原视频可播放性，必要时准备可取消的兼容预览。锁定轨道需先解锁。\n执行方式：异步操作，立即返回 jobId；使用 open_media_job_get({id:jobId}) 查询，completed 后读取 result；使用 open_media_job_cancel({id:jobId}) 取消。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "description": "源视频或工程压缩视频的素材 ID；省略时恢复工程全部启用的工作副本。"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "当前项目 revision，不一致时拒绝操作。"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "jobIdField": "jobId",
        "statusField": "state",
        "resultField": "result",
        "errorField": "errorDetails",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  },
  {
    "name": "open_media_clip_split_idle",
    "description": "检测所选视频片段中持续静止的源画面，按最短时间线时长与画面变化阈值自动分割，并将静止段标记为黄色 repeat。保留全部内容、片段位置及声音，不删除、不接拢；可一次撤销。仅扫描片段源范围，支持裁剪、倍速及分段变速。minDuration 默认 3 秒，freezeNoiseDb 默认 -60，数值越接近 0 判定越宽松。返回源区间、时间线分段、repeatCount、splitCount、repeatDuration。主动定格不参与检测；切点若会破坏淡入淡出或已有转场，将拒绝整次修改。\n执行方式：异步操作，立即返回 jobId；使用 open_media_job_get({id:jobId}) 查询，state=completed 后读取 result，可通过 open_media_job_cancel({id:jobId}) 取消；取消或失败不会分割时间线。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clipId"
      ],
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "minDuration": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3600,
          "default": 3
        },
        "freezeNoiseDb": {
          "type": "number",
          "minimum": -100,
          "maximum": -20,
          "default": -60
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "jobIdField": "jobId",
        "statusField": "state",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "resultField": "result",
        "errorField": "errorDetails",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  },
  {
    "name": "open_media_clip_classify",
    "description": "将视频轨道中的视频片段标记为 repeat（黄色），或使用 normal 恢复普通类型；仅改变编辑标记，不改变素材、播放或导出内容。类型随工程保存，分割与复制时保留。支持批量事务及撤销。\n执行方式：同步返回最终结果。",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clipId",
        "classification"
      ],
      "properties": {
        "clipId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "classification": {
          "type": "string",
          "enum": [
            "repeat",
            "normal"
          ]
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "synchronous",
        "responseType": "result",
        "final": true
      }
    }
  }
