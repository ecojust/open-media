[
  {
    "name": "open_media_video_generation_status",
    "description": "查询本地视频生成平台支持、运行时、模型大小、下载与校验状态；忙碌时仍可调用。\n执行方式：同步返回最终结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "从 project_get 返回值获取的项目版本；写操作建议提供，版本不一致时拒绝修改。"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "synchronous",
        "responseType": "result"
      }
    }
  },
  {
    "name": "open_media_video_model_download",
    "description": "按需下载并校验固定清单中的视频生成模型与运行时。须先向用户说明许可和下载大小并获得同意，再明确设置 acceptedLicense=true；不自动接受许可。通过统一任务查询下载进度和取消。\n执行方式：异步操作：立即返回 jobId（兼容 id），此时不是最终结果。使用 open_media_job_get({id:jobId}) 查询；state=completed 后读取 result，failed 时读取 errorDetails；可用 open_media_job_cancel({id:jobId}) 取消。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "enum": [
            "h3-base-fl2va",
            "h3-base-ref2va"
          ]
        },
        "acceptedLicense": {
          "type": "boolean",
          "enum": [
            true
          ],
          "description": "用户已阅读并同意所选模型许可。"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "从 project_get 返回值获取的项目版本；写操作建议提供，版本不一致时拒绝修改。"
        }
      },
      "required": [
        "modelId",
        "acceptedLicense"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "jobIdField": "jobId",
        "statusField": "state",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "resultField": "result",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  },
  {
    "name": "open_media_video_generation_start",
    "description": "通过提示词、首尾帧、参考素材或分镜生成视频。FL2VA 支持 prompt/image/storyboard，Ref2VA 支持 reference。素材仅用当前工程 assetId 引用，不接受文件路径；每镜1–15秒，最多20镜，图音视频参考限制由模型核验。默认512×512、20步、1秒、低内存；使用有声视频参考时默认2秒。所有镜头成功后一次加入素材；可用 insert 指定视频轨道和时间（省略轨道会新建），mode=shots逐镜或combined合并插入，可整体撤销。失败或取消不修改工程；生成完成后 result 返回 assetIds、clipIds、nativeJobId。\n执行方式：异步操作：立即返回 jobId（兼容 id），此时不是最终结果。使用 open_media_job_get({id:jobId}) 查询；state=completed 后读取 result，failed 时读取 errorDetails；可用 open_media_job_cancel({id:jobId}) 取消。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "enum": [
            "h3-base-fl2va",
            "h3-base-ref2va"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "prompt",
            "image",
            "reference",
            "storyboard"
          ]
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 15,
          "description": "默认1秒；有声视频参考默认2秒，显式请求过短时会报错。实际帧数按模型时间步取整，结果时长以生成素材为准。"
        },
        "firstFrameAssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lastFrameAssetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "properties": {
              "assetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "enum": [
                  "image",
                  "video",
                  "audio"
                ]
              },
              "includeAudio": {
                "type": "boolean"
              }
            },
            "required": [
              "assetId",
              "kind"
            ],
            "additionalProperties": false
          }
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 8000
              },
              "seconds": {
                "type": "number",
                "minimum": 1,
                "maximum": 15,
                "description": "默认1秒；有声视频参考默认2秒，显式请求过短时会报错。实际帧数按模型时间步取整，结果时长以生成素材为准。"
              },
              "firstFrameAssetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "lastFrameAssetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "references": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "properties": {
                    "assetId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "image",
                        "video",
                        "audio"
                      ]
                    },
                    "includeAudio": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "assetId",
                    "kind"
                  ],
                  "additionalProperties": false
                }
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "prompt"
            ],
            "additionalProperties": false
          }
        },
        "width": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4032,
          "description": "默认512，须为32倍数且宽高乘积不超过1344×768。"
        },
        "height": {
          "type": "integer",
          "minimum": 256,
          "maximum": 4032,
          "description": "默认512，须为32倍数且宽高乘积不超过1344×768。"
        },
        "steps": {
          "type": "integer",
          "minimum": 4,
          "maximum": 50
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "lowMemory": {
          "type": "boolean"
        },
        "joinShots": {
          "type": "boolean",
          "description": "默认true，将分镜额外合并成一段视频。"
        },
        "insert": {
          "type": "object",
          "properties": {
            "trackId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "start": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            },
            "mode": {
              "type": "string",
              "enum": [
                "shots",
                "combined"
              ]
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "从 project_get 返回值获取的项目版本；写操作建议提供，版本不一致时拒绝修改。"
        }
      },
      "required": [
        "modelId",
        "mode"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "jobIdField": "jobId",
        "statusField": "state",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "resultField": "result",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  }
]
