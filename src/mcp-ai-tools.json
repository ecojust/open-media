              "description": "省略时新建对应类型轨道；已有轨道必须未锁定。"
            },
            "start": {
              "type": "number",
              "minimum": 0,
              "maximum": 86400
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "从 project_get 返回值获取的项目版本；写操作建议提供，版本不一致时拒绝修改。"
        }
      },
      "required": [
        "modelId",
