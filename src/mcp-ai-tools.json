  {
    "name": "open_media_ai_job_get",
    "description": "查询全局 AI 原生任务，包括从界面发起的任务；id取自 ai_status.jobs 或生成结果 nativeJobId。此查询同步返回任务快照，state=completed 才表示生成完成；本工具的final只表示本次查询已返回。MCP 异步包装任务仍使用 open_media_job_get。\n执行方式：同步返回本次查询或操作结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "从 project_get 返回值获取的项目版本；写操作建议提供，版本不一致时拒绝修改。"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "synchronous",
        "responseType": "result"
      }
    }
  },
