[
  {
    "name": "open_media_ai_status",
    "description": "查询主应用共享的所有 AI 模型、体积、许可、硬件要求、下载/运行环境状态及全局任务。包括已有语音与视频模型，不重复下载已有安装；忙碌时仍可查询。任务中的素材仅返回公开元数据。\n执行方式：同步返回本次查询或操作结果。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "probeRuntime": {
          "type": "boolean"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "从 project_get 返回值获取的项目版本；写操作建议提供，版本不一致时拒绝修改。"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "synchronous",
        "responseType": "result"
      }
    }
  },
  {
    "name": "open_media_ai_model_download",
    "description": "按需安装全局目录中的模型及对应隔离运行环境；必须先向用户说明许可和下载体积并获得同意。完成后返回模型状态；下载字节与校验阶段通过统一任务查询。\n执行方式：异步操作，立即返回 jobId；使用 open_media_job_get({id:jobId}) 查询，completed 后读取 result，failed 后读取 errorDetails；使用 open_media_job_cancel({id:jobId}) 取消。忙碌错误附带阻塞任务的查询与取消链接。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "从 open_media_ai_status 获取的模型 ID，覆盖语音、视频、图像和音乐模型。"
        },
        "acceptedLicense": {
          "type": "boolean",
          "enum": [
            true
          ],
          "description": "用户已了解模型大小及许可，并同意安装；不得代替用户自动同意。"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "从 project_get 返回值获取的项目版本；写操作建议提供，版本不一致时拒绝修改。"
        }
      },
      "required": [
        "modelId",
        "acceptedLicense"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true
    },
    "_meta": {
      "openmedia/execution": {
        "mode": "asynchronous",
        "responseType": "job",
        "jobIdField": "jobId",
        "statusField": "state",
        "pollingTool": "open_media_job_get",
        "cancelTool": "open_media_job_cancel",
        "resultField": "result",
        "terminalStates": [
          "completed",
          "failed",
          "cancelled"
        ]
      }
    }
  },
